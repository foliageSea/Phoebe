{
  "name": "@local/dsh-phoebe-voice",
  "version": "1.1.0",
  "description": "Phoebe-style Fish Audio announcements for DSH questions and final replies.",
  "private": true,
  "type": "module",
  "engines": { "dsh": "0.2.2-rc.5", "node": ">=22" },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.jpg"
  },
  "files": ["index.js", "client.js", "hooks.js", "speech.js", "playback.js", "cordis.patch.yml", "locale/*.json", "icon.jpg", "README.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-ui-plugin-manager"] }
  },
  "scripts": { "test": "node --test" },
  "dependencies": { "@deepseek-ai/schemastery": "3.19.0" }
}
